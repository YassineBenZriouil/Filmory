rules_version = '2';

// Filmory security rules.
// Lists keep their owner as the string "/Users/<uid>" in `user`, so ownership is
// checked against that string; no data migration is needed.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownerPath() {
      return '/Users/' + request.auth.uid;
    }

    // Top-level fields this write changes.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The array `field` changes only by adding or removing the caller's own uid.
    function onlyMyUidChanged(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }

    // Private account details (includes the email). Only the owner.
    match /Users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Public display name shown on public lists. Anyone can read; only the owner writes,
    // and only a short userName.
    match /Profiles/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userName'])
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 40;
    }

    // What each person has watched, and who they follow. Private to them.
    match /Watched/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /Follows/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Anyone signed in can report; nobody can read reports from the app.
    // Review them in the Firebase console.
    match /Reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['listId', 'reason', 'details', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.reason in ['offensive', 'spam', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500;
    }

    match /Mylists/{listId} {
      function isOwner() {
        return signedIn() && resource.data.user == ownerPath();
      }
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      // Public lists: anyone. Private lists: the owner and the people they shared it with.
      allow read: if resource.data.isPublic == true || isOwner() || isMember();

      // New lists belong to whoever creates them and start unshared, unliked and unmoderated.
      allow create: if signedIn()
        && request.resource.data.user == ownerPath()
        && request.resource.data.listName is string
        && request.resource.data.listName.size() > 0
        && request.resource.data.listName.size() <= 60
        && request.resource.data.get('members', []).size() == 0
        && request.resource.data.get('likedBy', []).size() == 0
        && !('hidden' in request.resource.data);

      // Owner: anything except who owns it, its likes, and moderation. A list a moderator
      // hid (hidden: true, set in the console) can't be made public again.
      allow update: if isOwner()
        && !changed().hasAny(['user', 'likedBy', 'hidden'])
        && !(resource.data.get('hidden', false) == true && request.resource.data.get('isPublic', false) == true);

      // People the list is shared with: films, order and per-film notes/interest only.
      allow update: if isMember()
        && changed().hasOnly(['works', 'order', 'meta']);

      // A member leaving: removes only themselves.
      allow update: if isMember()
        && changed().hasOnly(['members'])
        && onlyMyUidChanged('members')
        && !(request.auth.uid in request.resource.data.members);

      // Joining from an invite link: adds only yourself, and only with the current invite code.
      allow update: if signedIn()
        && changed().hasOnly(['members', 'joinedWith'])
        && resource.data.get('inviteToken', '') != ''
        && request.resource.data.joinedWith == resource.data.inviteToken
        && onlyMyUidChanged('members')
        && request.auth.uid in request.resource.data.members;

      // Liking a public list someone else made: adds or removes only your own like.
      allow update: if signedIn()
        && !isOwner()
        && resource.data.isPublic == true
        && changed().hasOnly(['likedBy'])
        && onlyMyUidChanged('likedBy');

      allow delete: if isOwner();
    }
  }
}
